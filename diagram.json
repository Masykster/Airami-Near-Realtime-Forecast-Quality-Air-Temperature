{
  "version": 1,
  "author": "Smart Environment Monitor AIoT",
  "editor": "izin ke toilet",
  "parts": [
    {
      "type": "board-esp32-devkit-c-v4",
      "id": "esp",
      "top": 0,
      "left": 0,
      "attrs": {}
    },
    {
      "type": "board-ssd1306",
      "id": "oled1",
      "top": -20,
      "left": 150,
      "attrs": { "i2cAddress": "0x3c" }
    },
    {
      "type": "wokwi-dht22",
      "id": "dht1",
      "top": 95,
      "left": 160,
      "attrs": {}
    },
    {
      "type": "wokwi-servo",
      "id": "servo1",
      "top": 215,
      "left": 150,
      "attrs": {}
    },
    {
      "type": "wokwi-buzzer",
      "id": "bz1",
      "top": -110,
      "left": 45,
      "attrs": { "volume": "0.2" }
    },
    {
      "type": "wokwi-photoresistor-sensor",
      "id": "ldr1",
      "top": 40,
      "left": -230,
      "attrs": {}
    },
    {
      "type": "wokwi-gas-sensor",
      "id": "gas1",
      "top": -90,
      "left": -210,
      "attrs": {}
    },
    {
      "type": "wokwi-led",
      "id": "led1",
      "top": 140,
      "left": -110,
      "attrs": { "color": "red" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r1",
      "top": 200,
      "left": -125,
      "rotate": 90,
      "attrs": { "value": "220" }
    }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],

    [ "oled1:VCC", "esp:3V3", "red", [ "v-15", "h-150" ] ],
    [ "oled1:GND", "esp:GND.2", "black", [ "v-25", "h-85" ] ],
    [ "oled1:SCL", "esp:22", "yellow", [ "v-5", "h-65", "v45" ] ],
    [ "oled1:SDA", "esp:21", "blue", [ "v5", "h-55", "v65" ] ],

    [ "dht1:VCC", "esp:3V3", "red", [ "v20", "h-170" ] ],
    [ "dht1:GND", "esp:GND.2", "black", [ "v30", "h-100" ] ],
    [ "dht1:SDA", "esp:15", "green", [ "v10", "h-75", "v-55" ] ],

    [ "servo1:V+", "esp:5V", "red", [ "h-30", "v-55", "h-130" ] ],
    [ "servo1:GND", "esp:GND.2", "black", [ "h-40", "v-195" ] ],
    [ "servo1:PWM", "esp:18", "orange", [ "h-50", "v-130" ] ],

    [ "bz1:1", "esp:GND.2", "black", [ "v20", "h30" ] ],
    [ "bz1:2", "esp:19", "purple", [ "v30", "h45", "v150" ] ],

    [ "ldr1:VCC", "esp:3V3", "red", [ "h30", "v-40" ] ],
    [ "ldr1:GND", "esp:GND.1", "black", [ "h20", "v90" ] ],
    [ "ldr1:AO", "esp:34", "purple", [ "h40", "v5" ] ],

    [ "gas1:VCC", "esp:3V3", "red", [ "h50", "v90" ] ],
    [ "gas1:GND", "esp:GND.1", "black", [ "h40", "v220" ] ],
    [ "gas1:AOUT", "esp:35", "cyan", [ "h60", "v145" ] ],

    [ "esp:2", "led1:A", "orange", [ "h80", "v80", "h-200" ] ],
    [ "led1:C", "r1:1", "black", [ "v0" ] ],
    [ "r1:2", "esp:GND.1", "black", [ "v10", "h100" ] ]
  ],
  "dependencies": {}
}
